# 后端部署环境变量
# 复制为 .env 并修改值
# 注意：值不要加引号，systemd EnvironmentFile 会把引号当作值的一部分

# 回调地址（RPA Worker 用此地址回调结果，必须是 Worker 可访问的地址）
# 部署时通过 Nginx 代理
CALLBACK_BASE_URL=http://192.168.3.100:8088

# CORS 允许的前端地址（逗号分隔）
# 部署时前端通过 Nginx 访问
CORS_ORIGINS=http://192.168.3.100:8088

# Redis 连接（可选，不配置则使用文件派发）
REDIS_URL=redis://localhost:6379/0

# RPA 回调超时（秒，默认 600）
# RPA_CALLBACK_TIMEOUT=600
